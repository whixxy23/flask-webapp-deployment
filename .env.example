# Copy this to .env (gitignored) for LOCAL development only.
# In production, these are set as GitHub Actions secrets instead —
# see the CI/CD Pipeline section of the README.

DB_HOST=your-rds-endpoint.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=webapp
DB_USER=webapp_admin
DB_PASSWORD=changeme
DB_PORT=5432

# Optional locally (defaults to the 'db' container if unset).
# In production this is set to the real RDS endpoint via a GitHub secret.
# DB_HOST=database-1.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-one

